# =====================================================================
# 2. ORTHOGONALITY VALIDATION
# =====================================================================
def verify_orthogonality(f1, f2, Tb, fs):
    """
    Validates mathematical orthogonality between BFSK tone 1 and tone 2 over bit period Tb.
    """
    t = np.arange(0, Tb, 1/fs)
    phi1 = np.cos(2 * np.pi * f1 * t)
    phi2 = np.cos(2 * np.pi * f2 * t)
    
    # Continuous-time inner product approximated by Riemann sum
    inner_prod = np.sum(phi1 * phi2) / fs
    norm_phi1 = np.sqrt(np.sum(phi1**2) / fs)
    norm_phi2 = np.sqrt(np.sum(phi2**2) / fs)
    cross_corr = inner_prod / (norm_phi1 * norm_phi2)
    
    print("\n" + "="*60)
    print("           BFSK TONE ORTHOGONALITY VALIDATION")
    print("="*60)
    print(f"  Tone 1 (f1)            : {f1:.1f} Hz ({int(f1*Tb)} cycles/bit)")
    print(f"  Tone 2 (f2)            : {f2:.1f} Hz ({int(f2*Tb)} cycles/bit)")
    print(f"  Tone separation (Delta f): {abs(f2 - f1):.1f} Hz = {abs(f2 - f1)*Tb:.1f}/Tb")
    print(f"  Inner Product <phi1, phi2>: {inner_prod:.6e}")
    print(f"  Normalized Correlation   : {cross_corr:.6e}")
    if abs(cross_corr) < 1e-3:
        print("  Status: EXACTLY ORTHOGONAL over bit period Tb.")
    else:
        print("  Status: APPROXIMATELY ORTHOGONAL.")
    print("="*60 + "\n")
    return inner_prod


# =====================================================================
# 3. MODULATION MODULES (VECTORIZED)
# =====================================================================
def ask_modulate(bits, fc, Tb, fs, A=1.0):
    """
    Generates Binary Amplitude Shift Keying (BASK / OOK) passband waveform.
    s(t) = A * cos(2*pi*fc*t) for bit 1, and 0 for bit 0.
    """
    dt = 1.0 / fs
    t_bit = np.arange(0, Tb, dt)
    carrier = A * np.cos(2 * np.pi * fc * t_bit)
    
    # Fast 2D broadcasting
    # bits shape: (Nbits, 1), carrier shape: (1, Ns)
    signal_matrix = bits[:, np.newaxis] * carrier[np.newaxis, :]
    return signal_matrix.ravel()


def bfsk_modulate(bits, f1, f2, Tb, fs, A=1.0):
    """
    Generates Binary Frequency Shift Keying (BFSK) passband waveform.
    s(t) = A * cos(2*pi*f1*t) for bit 1 (Mark), A * cos(2*pi*f2*t) for bit 0 (Space).
    """
    dt = 1.0 / fs
    t_bit = np.arange(0, Tb, dt)
    tone1 = A * np.cos(2 * np.pi * f1 * t_bit)
    tone2 = A * np.cos(2 * np.pi * f2 * t_bit)
    
    # Fast 2D broadcasting
    b = bits[:, np.newaxis]
    signal_matrix = b * tone1[np.newaxis, :] + (1 - b) * tone2[np.newaxis, :]
    return signal_matrix.ravel()


# =====================================================================
# 4. AWGN CHANNEL (CALIBRATED TO ENERGY PER BIT Eb)
# =====================================================================
def add_awgn_channel(signal, EbN0_dB, mod_type='BFSK', A=1.0, Tb=1.0, fs=200):
    """
    Adds Additive White Gaussian Noise (AWGN) calibrated to Eb/N0 in dB.
    
    Energy per bit:
      - For BFSK: Eb = A^2 * Tb / 2
      - For ASK (OOK with equal priors): Eb = (1/2)*(A^2 * Tb / 2) = A^2 * Tb / 4
      
    Sample noise variance:
      sigma_w^2 = (N0 / 2) * fs = (Eb / (10^(EbN0_dB/10))) * (fs / 2)
    """
    if mod_type == 'ASK':
        Eb = (A**2 * Tb) / 4.0
    else:  # BFSK
        Eb = (A**2 * Tb) / 2.0
        
    EbN0_linear = 10.0 ** (EbN0_dB / 10.0)
    N0 = Eb / EbN0_linear
    sigma_w = np.sqrt((N0 / 2.0) * fs)
    
    noise = sigma_w * np.random.randn(len(signal))
    return signal + noise, N0, sigma_w


# =====================================================================
# 5. DEMODULATION & CORRELATION DETECTORS (VECTORIZED)
# =====================================================================
def ask_coherent_demod(rx_signal, fc, Tb, fs, Nbits, A=1.0, return_continuous=False):
    """
    Coherent ASK Correlator Receiver:
    Correlates with local carrier c(t) = cos(2*pi*fc*t).
    Decision threshold gamma = (A * Tb) / 4.
    """
    Ns = int(Tb * fs)
    dt = 1.0 / fs
    t_bit = np.arange(0, Tb, dt)
    carrier = np.cos(2 * np.pi * fc * t_bit)
    gamma_threshold = (A * Tb) / 4.0
    
    # Reshape received signal to (Nbits, Ns)
    rx_matrix = rx_signal[:Nbits * Ns].reshape(Nbits, Ns)
    
    # Discrete integration for each bit symbol
    decision_stats = np.sum(rx_matrix * carrier, axis=1) * dt
    detected_bits = (decision_stats > gamma_threshold).astype(int)
    
    continuous_corr = None
    if return_continuous:
        continuous_corr = (np.cumsum(rx_matrix * carrier, axis=1) * dt).ravel()
        
    return detected_bits, decision_stats, continuous_corr, gamma_threshold


def bfsk_coherent_demod(rx_signal, f1, f2, Tb, fs, Nbits, return_continuous=False):
    """
    Coherent BFSK Dual-Correlator Receiver:
    Correlates with c1(t) = cos(2*pi*f1*t) and c2(t) = cos(2*pi*f2*t).
    Decision Statistic Lambda = r1 - r2. Threshold gamma = 0.
    """
    Ns = int(Tb * fs)
    dt = 1.0 / fs
    t_bit = np.arange(0, Tb, dt)
    c1 = np.cos(2 * np.pi * f1 * t_bit)
    c2 = np.cos(2 * np.pi * f2 * t_bit)
    
    rx_matrix = rx_signal[:Nbits * Ns].reshape(Nbits, Ns)
    
    r1_stats = np.sum(rx_matrix * c1, axis=1) * dt
    r2_stats = np.sum(rx_matrix * c2, axis=1) * dt
    decision_stats = r1_stats - r2_stats
    detected_bits = (decision_stats > 0).astype(int)
    
    cont_r1, cont_r2, cont_diff = None, None, None
    if return_continuous:
        cont_r1 = (np.cumsum(rx_matrix * c1, axis=1) * dt).ravel()
        cont_r2 = (np.cumsum(rx_matrix * c2, axis=1) * dt).ravel()
        cont_diff = cont_r1 - cont_r2
        
    return detected_bits, decision_stats, r1_stats, r2_stats, cont_r1, cont_r2, cont_diff


def bfsk_noncoherent_demod(rx_signal, f1, f2, Tb, fs, Nbits):
    """
    Non-coherent BFSK Quadrature / Envelope Correlator Detector:
    Branch 1: I1 = int r*cos(w1*t), Q1 = int r*sin(w1*t) -> V1 = I1^2 + Q1^2
    Branch 2: I2 = int r*cos(w2*t), Q2 = int r*sin(w2*t) -> V2 = I2^2 + Q2^2
    Decision: 1 if V1 > V2 else 0.
    """
    Ns = int(Tb * fs)
    dt = 1.0 / fs
    t_bit = np.arange(0, Tb, dt)
    
    c1_cos = np.cos(2 * np.pi * f1 * t_bit)
    c1_sin = np.sin(2 * np.pi * f1 * t_bit)
    c2_cos = np.cos(2 * np.pi * f2 * t_bit)
    c2_sin = np.sin(2 * np.pi * f2 * t_bit)
    
    rx_matrix = rx_signal[:Nbits * Ns].reshape(Nbits, Ns)
    
    I1 = np.sum(rx_matrix * c1_cos, axis=1) * dt
    Q1 = np.sum(rx_matrix * c1_sin, axis=1) * dt
    V1 = I1**2 + Q1**2
    
    I2 = np.sum(rx_matrix * c2_cos, axis=1) * dt
    Q2 = np.sum(rx_matrix * c2_sin, axis=1) * dt
    V2 = I2**2 + Q2**2
    
    decision_stats = V1 - V2
    detected_bits = (V1 > V2).astype(int)
    
    return detected_bits, decision_stats


def compute_psd_welch(signal, fs, nperseg=1024, noverlap=512):
    """
    Computes Power Spectral Density (PSD) using Welch's averaged periodogram with Hann window.
    Pure NumPy implementation ensuring zero external dependencies.
    """
    step = nperseg - noverlap
    window = np.hanning(nperseg)
    scale = 1.0 / (fs * np.sum(window**2))
    
    num_segments = (len(signal) - noverlap) // step
    psd_accum = np.zeros(nperseg // 2 + 1)
    
    for i in range(num_segments):
        start = i * step
        segment = signal[start:start + nperseg] * window
        fft_vals = np.fft.rfft(segment, n=nperseg)
        psd_accum += np.abs(fft_vals)**2
        
    psd = (psd_accum / num_segments) * scale
    if nperseg % 2 == 0:
        psd[1:-1] *= 2.0
    else:
        psd[1:] *= 2.0
        
    freqs = np.fft.rfftfreq(nperseg, 1.0 / fs)
    return freqs, psd


# =====================================================================
# 6. THEORETICAL BER EQUATIONS
# =====================================================================
def q_func(x):
    """
    Gaussian Q-function in terms of complementary error function:
    Q(x) = 0.5 * erfc(x / sqrt(2))
    """
    x_arr = np.asarray(x, dtype=float)
    erfc_vec = np.vectorize(math.erfc)
    return 0.5 * erfc_vec(x_arr / np.sqrt(2.0))

def theoretical_ber_ask_coherent(EbN0_dB):
    """Coherent BASK (OOK): Pb = Q(sqrt(Eb/N0))"""
    EbN0_lin = 10.0 ** (np.array(EbN0_dB, dtype=float) / 10.0)
    return q_func(np.sqrt(EbN0_lin))

def theoretical_ber_bfsk_coherent(EbN0_dB):
    """Coherent Orthogonal BFSK: Pb = Q(sqrt(Eb/N0))"""
    EbN0_lin = 10.0 ** (np.array(EbN0_dB, dtype=float) / 10.0)
    return q_func(np.sqrt(EbN0_lin))

def theoretical_ber_bfsk_noncoherent(EbN0_dB):
    """Non-coherent Orthogonal BFSK: Pb = 0.5 * exp(-0.5 * Eb/N0)"""
    EbN0_lin = 10.0 ** (np.array(EbN0_dB, dtype=float) / 10.0)
    return 0.5 * np.exp(-0.5 * EbN0_lin)


