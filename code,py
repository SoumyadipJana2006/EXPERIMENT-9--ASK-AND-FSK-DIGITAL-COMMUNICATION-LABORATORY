    axs3[2].set_title(r"BFSK Decision Variable: Choose Bit 1 if $\Lambda_k > 0$, else Bit 0", fontweight='bold', fontsize=11)
    axs3[2].grid(True, linestyle='--', alpha=0.6)
    axs3[2].legend(loc='upper right')

    for k, b in enumerate(demo_bits):
        for ax in axs3:
            ax.axvline(k * Tb, color='gray', linestyle=':', alpha=0.5)
        axs3[0].text((k + 0.5) * Tb, 0.58, f"b={b}", ha='center', va='center',
                     fontweight='bold', color='navy', fontsize=9,
                     bbox=dict(boxstyle='square,pad=0.1', facecolor='aliceblue', alpha=0.7))
    axs3[0].axvline(N_demo * Tb, color='gray', linestyle=':', alpha=0.5)

    plt.tight_layout(rect=[0, 0, 1, 0.96])
    plt.savefig("3_correlator_outputs.png", dpi=300)
    print("[3/5] Generated & Saved '3_correlator_outputs.png'")

    # -------------------------------------------------------------
    # VISUALIZATION 4: DECISION-STATISTIC HISTOGRAMS
    # -------------------------------------------------------------
    # Run high-sample count simulation for rich empirical conditional distributions
    hist_bits = np.random.randint(0, 2, N_stat_bits)
    hist_snr = 6.0  # Moderate SNR to clearly show Gaussian distributions and error overlap tails
    
    ask_hist_tx = ask_modulate(hist_bits, fc, Tb, fs, A=A)
    bfsk_hist_tx = bfsk_modulate(hist_bits, f1, f2, Tb, fs, A=A)
    
    ask_hist_rx, N0_ask, sigma_w_ask = add_awgn_channel(ask_hist_tx, hist_snr, 'ASK', A, Tb, fs)
    bfsk_hist_rx, N0_bfsk, sigma_w_bfsk = add_awgn_channel(bfsk_hist_tx, hist_snr, 'BFSK', A, Tb, fs)
    
    _, ask_hist_stats, _, ask_th = ask_coherent_demod(ask_hist_rx, fc, Tb, fs, N_stat_bits, A=A)
    _, bfsk_hist_stats, _, _, _, _, _ = bfsk_coherent_demod(bfsk_hist_rx, f1, f2, Tb, fs, N_stat_bits)
    _, bfsk_noncoh_stats = bfsk_noncoherent_demod(bfsk_hist_rx, f1, f2, Tb, fs, N_stat_bits)

    # Separate decision statistics by transmitted bit
    ask_stats_b0 = ask_hist_stats[hist_bits == 0]
    ask_stats_b1 = ask_hist_stats[hist_bits == 1]
    
    bfsk_stats_b0 = bfsk_hist_stats[hist_bits == 0]
    bfsk_stats_b1 = bfsk_hist_stats[hist_bits == 1]
    
    bfsk_non_b0 = bfsk_noncoh_stats[hist_bits == 0]
    bfsk_non_b1 = bfsk_noncoh_stats[hist_bits == 1]

    fig4, axs4 = plt.subplots(1, 3, figsize=(16, 5.5))
    fig4.suptitle(f"Required Visualization 4: Decision-Statistic Empirical Distributions ($E_b/N_0 = {hist_snr:.0f}$ dB)", 
                  fontsize=14, fontweight='bold', y=0.98)

    # Subplot 1: ASK Coherent Histogram
    axs4[0].hist(ask_stats_b0, bins=50, density=True, alpha=0.6, color='#1f77b4', label=r'Bit 0 sent: $p(\Lambda|b=0)$')
    axs4[0].hist(ask_stats_b1, bins=50, density=True, alpha=0.6, color='#ff7f0e', label=r'Bit 1 sent: $p(\Lambda|b=1)$')
    axs4[0].axvline(ask_th, color='red', linestyle='--', lw=2.0, label=f'Threshold $\\gamma = {ask_th:.2f}$')
    axs4[0].set_title("Coherent BASK Decision Statistic $\\Lambda$", fontweight='bold', fontsize=11)
    axs4[0].set_xlabel("Decision Variable Value", fontweight='bold')
    axs4[0].set_ylabel("Probability Density $p(\\Lambda)$", fontweight='bold')
    axs4[0].grid(True, linestyle='--', alpha=0.6)
    axs4[0].legend(loc='upper right', fontsize=9)

    # Subplot 2: BFSK Coherent Histogram
    axs4[1].hist(bfsk_stats_b0, bins=50, density=True, alpha=0.6, color='#1f77b4', label=r'Bit 0 sent: $p(r_1 - r_2|b=0)$')
    axs4[1].hist(bfsk_stats_b1, bins=50, density=True, alpha=0.6, color='#2ca02c', label=r'Bit 1 sent: $p(r_1 - r_2|b=1)$')
    axs4[1].axvline(0, color='red', linestyle='--', lw=2.0, label='Threshold $\\gamma = 0$')
    axs4[1].set_title("Coherent BFSK Decision Statistic $\\Lambda = r_1 - r_2$", fontweight='bold', fontsize=11)
    axs4[1].set_xlabel("Decision Variable Value ($r_1 - r_2$)", fontweight='bold')
    axs4[1].set_ylabel("Probability Density", fontweight='bold')
    axs4[1].grid(True, linestyle='--', alpha=0.6)
    axs4[1].legend(loc='upper right', fontsize=9)

    # Subplot 3: BFSK Non-coherent Histogram (Envelope Detection Metric)
    axs4[2].hist(bfsk_non_b0, bins=50, density=True, alpha=0.6, color='#1f77b4', label=r'Bit 0 sent: $p(V_1 - V_2|b=0)$')
    axs4[2].hist(bfsk_non_b1, bins=50, density=True, alpha=0.6, color='#d62728', label=r'Bit 1 sent: $p(V_1 - V_2|b=1)$')
    axs4[2].axvline(0, color='red', linestyle='--', lw=2.0, label='Threshold $\\gamma = 0$')
    axs4[2].set_title("Non-coherent BFSK Decision Metric $V_1 - V_2$", fontweight='bold', fontsize=11)
    axs4[2].set_xlabel("Envelope Metric ($V_1 - V_2$)", fontweight='bold')
    axs4[2].set_ylabel("Probability Density", fontweight='bold')
    axs4[2].grid(True, linestyle='--', alpha=0.6)
    axs4[2].legend(loc='upper right', fontsize=9)

    plt.tight_layout(rect=[0, 0, 1, 0.95])
    plt.savefig("4_decision_statistic_histograms.png", dpi=300)
    print("[4/5] Generated & Saved '4_decision_statistic_histograms.png'")

    # -------------------------------------------------------------
    # VISUALIZATION 5: BER CURVES (SIMULATED VS THEORETICAL)
    # -------------------------------------------------------------
    print("\nExecuting Monte Carlo Bit Error Rate Simulation across SNR range...")
    start_time = time.time()
    
    ber_sim_ask_coh = []
    ber_sim_bfsk_coh = []
    ber_sim_bfsk_non = []
    
    # Pre-generate bits for the BER trial
    ber_bits = np.random.randint(0, 2, N_ber_bits)
    ask_ber_tx = ask_modulate(ber_bits, fc, Tb, fs, A=A)
    bfsk_ber_tx = bfsk_modulate(ber_bits, f1, f2, Tb, fs, A=A)
    
    for snr_db in EbN0_dB_list:
        # Channel simulation
        rx_ask, _, _ = add_awgn_channel(ask_ber_tx, snr_db, 'ASK', A, Tb, fs)
        rx_bfsk, _, _ = add_awgn_channel(bfsk_ber_tx, snr_db, 'BFSK', A, Tb, fs)
        
        # Demodulation
        det_ask, _, _, _ = ask_coherent_demod(rx_ask, fc, Tb, fs, N_ber_bits, A=A)
        det_bfsk_coh, _, _, _, _, _, _ = bfsk_coherent_demod(rx_bfsk, f1, f2, Tb, fs, N_ber_bits)
        det_bfsk_non, _ = bfsk_noncoherent_demod(rx_bfsk, f1, f2, Tb, fs, N_ber_bits)
        
        # Compute BER
        ber_ask = np.mean(ber_bits != det_ask)
        ber_bfsk_c = np.mean(ber_bits != det_bfsk_coh)
        ber_bfsk_n = np.mean(ber_bits != det_bfsk_non)
        
        ber_sim_ask_coh.append(ber_ask)
        ber_sim_bfsk_coh.append(ber_bfsk_c)
        ber_sim_bfsk_non.append(ber_bfsk_n)
        
    elapsed = time.time() - start_time
    print(f"Monte Carlo BER Simulation finished in {elapsed:.2f} seconds.")

    # High-resolution smooth theoretical curves
    snr_fine_db = np.linspace(EbN0_dB_list[0], EbN0_dB_list[-1], 200)
    ber_theo_ask = theoretical_ber_ask_coherent(snr_fine_db)
    ber_theo_bfsk_coh = theoretical_ber_bfsk_coherent(snr_fine_db)
    ber_theo_bfsk_non = theoretical_ber_bfsk_noncoherent(snr_fine_db)

    fig5, ax5 = plt.subplots(figsize=(11, 7.5))
    fig5.suptitle("Required Visualization 5: Bit Error Rate (BER) Performance vs. $E_b/N_0$", 
                  fontsize=14, fontweight='bold', y=0.98)

    # Theoretical lines
    ax5.semilogy(snr_fine_db, ber_theo_ask, 'r-', lw=2.2, label=r'Theoretical ASK Coherent: $Q(\sqrt{E_b/N_0})$')
    ax5.semilogy(snr_fine_db, ber_theo_bfsk_coh, 'b--', lw=2.2, label=r'Theoretical BFSK Coherent: $Q(\sqrt{E_b/N_0})$')
    ax5.semilogy(snr_fine_db, ber_theo_bfsk_non, 'g-.', lw=2.2, label=r'Theoretical BFSK Non-coherent: $\frac{1}{2}\exp(-\frac{E_b}{2N_0})$')

    # Simulated data points with distinct markers
    # Filter 0 errors for clean semilog representation
    mask_ask = np.array(ber_sim_ask_coh) > 0
    mask_bfsk_c = np.array(ber_sim_bfsk_coh) > 0
    mask_bfsk_n = np.array(ber_sim_bfsk_non) > 0

    ax5.semilogy(EbN0_dB_list[mask_ask], np.array(ber_sim_ask_coh)[mask_ask], 'ro', markersize=7, 
                 label='Simulated ASK Coherent (Monte Carlo)', fillstyle='none', markeredgewidth=2)
    ax5.semilogy(EbN0_dB_list[mask_bfsk_c], np.array(ber_sim_bfsk_coh)[mask_bfsk_c], 'bs', markersize=7, 
                 label='Simulated BFSK Coherent (Monte Carlo)', fillstyle='none', markeredgewidth=2)
    ax5.semilogy(EbN0_dB_list[mask_bfsk_n], np.array(ber_sim_bfsk_non)[mask_bfsk_n], 'g^', markersize=7, 
                 label='Simulated BFSK Non-coherent (Monte Carlo)', fillstyle='none', markeredgewidth=2)

    ax5.set_xlabel("$E_b / N_0$ (dB)", fontweight='bold', fontsize=12)
    ax5.set_ylabel("Bit Error Rate (BER)", fontweight='bold', fontsize=12)
    ax5.set_title("Comparison of Modulations in AWGN Channel", fontweight='bold', fontsize=11)
    ax5.set_xlim(0, 12)
    ax5.set_ylim(1e-5, 1.0)
    ax5.grid(True, which='both', linestyle='--', alpha=0.7)
    ax5.legend(loc='lower left', fontsize=10, framealpha=0.95)

    plt.tight_layout(rect=[0, 0, 1, 0.96])
    plt.savefig("5_ber_curves.png", dpi=300)
    print("[5/5] Generated & Saved '5_ber_curves.png'")

    # -------------------------------------------------------------
    # CONSOLE PERFORMANCE SUMMARY TABLE
    # -------------------------------------------------------------
    print("\n" + "="*82)
    print("                    DIGITAL MODULATION BER COMPARISON TABLE")
    print("="*82)
    print(f"{'Eb/N0 (dB)':^11} | {'ASK Coherent (Sim / Theo)':^22} | {'BFSK Coherent (Sim / Theo)':^22} | {'BFSK Non-coh (Sim / Theo)':^22}")
    print("-"*82)
    for i, snr in enumerate(EbN0_dB_list):
        sim_a = ber_sim_ask_coh[i]
        theo_a = theoretical_ber_ask_coherent(snr)
        
        sim_bc = ber_sim_bfsk_coh[i]
        theo_bc = theoretical_ber_bfsk_coherent(snr)
        
        sim_bn = ber_sim_bfsk_non[i]
        theo_bn = theoretical_ber_bfsk_noncoherent(snr)
        
        print(f"{snr:^11.1f} | {sim_a:.5f} / {theo_a:.5f}      | {sim_bc:.5f} / {theo_bc:.5f}       | {sim_bn:.5f} / {theo_bn:.5f}")
    print("="*82 + "\n")

    # Display plots interactively
    plt.show()


